
from app import db
from datetime import datetime

class PortalMemberRole(db.Model):
    __tablename__ = 'portal_member_roles'

    id = db.Column(db.Integer, primary_key=True)
    portals_id = db.Column(db.Integer, db.ForeignKey('portals.id'), nullable=False)
    users_id = db.Column(db.Integer, db.ForeignKey('users.id'), nullable=False)
    role = db.Column(db.String(50), nullable=False)  # e.g., 'admin', 'editor', 'member'
    assigned_at = db.Column(db.DateTime, default=datetime.utcnow)

    __table_args__ = (
        db.UniqueConstraint('portals_id', 'users_id', 'role', name='uq_portal_user_role'),
        db.Index('ix_portal_user_role', 'portals_id', 'users_id', 'role'),
    )

    portal = db.relationship('Portal', backref='member_roles')
    user = db.relationship('User', backref='portal_roles')

    def __repr__(self):
        return f"<PortalMemberRole portal_id={self.portals_id} user_id={self.users_id} role={self.role}>"
        