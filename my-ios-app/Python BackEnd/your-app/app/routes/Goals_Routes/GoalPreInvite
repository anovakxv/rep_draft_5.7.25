
from app import db
from datetime import datetime

class GoalPreInvite(db.Model):
    __tablename__ = 'goal_pre_invites'

    id = db.Column(db.Integer, primary_key=True)
    users_id = db.Column(db.Integer, nullable=False)         # Who sent the invite
    goals_id = db.Column(db.Integer, nullable=False)         # Which goal
    type = db.Column(db.String(16), nullable=False)          # 'email', 'phone', 'fb'
    identifier = db.Column(db.String(128), nullable=False)   # Email, phone, or FB id
    timestamp = db.Column(db.DateTime, default=datetime.utcnow)

    def __repr__(self):
        return f"<GoalPreInvite id={self.id} users_id={self.users_id} goals_id={self.goals_id} type={self.type} identifier={self.identifier}>"