
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.Goals_Models.Goal import Goal
from app.models.Goals_Models.GoalTeam import GoalTeam
from app.models.Goals_Models.User import User

goals_bp = Blueprint('goals', __name__)

@goals_bp.route('/api/goals/team/manage', methods=['POST'])
def api_manage_goal_team():
    data = request.json
    user_id = session.get('user_id')
    goals_ids = data.get('aGoalsIDs', [])
    users = data.get('aUsers', [])
    todo = data.get('todo')  # 'join' or 'leave'

    if not user_id:
        return jsonify({'error': 'Login required!'}), 401
    if not goals_ids or not users or todo not in ['join', 'leave']:
        return jsonify({'error': 'Invalid request'}), 400

    results = {}
    for goal_id in goals_ids:
        goal = Goal.query.get(goal_id)
        if not goal:
            results[goal_id] = {'error': 'Goal not found'}
            continue

        results[goal_id] = {}
        # Validate all user IDs
        valid_users = User.query.filter(User.id.in_(users)).all()
        valid_user_ids = {u.id for u in valid_users}
        if len(valid_user_ids) != len(users):
            results[goal_id]['error'] = 'One or more user IDs are invalid'
            continue

        for u_id in users:
            team = GoalTeam.query.filter_by(goals_id=goal_id, users_id2=u_id).first()
            if todo == 'join':
                if team:
                    if team.confirmed == 1:
                        results[goal_id][u_id] = 'already in the team'
                    else:
                        results[goal_id][u_id] = 'invite already exists'
                else:
                    new_team = GoalTeam(goals_id=goal_id, users_id1=user_id, users_id2=u_id, confirmed=0)
                    db.session.add(new_team)
                    results[goal_id][u_id] = 'invited'
                    # Optionally: send invite notification here
            elif todo == 'leave':
                if team:
                    db.session.delete(team)
                    results[goal_id][u_id] = 'removed'
                    # Optionally: remove related activities or notifications
                else:
                    results[goal_id][u_id] = 'not a member'

    db.session.commit()
    return jsonify({'result': results})
    