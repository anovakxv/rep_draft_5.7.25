
from flask import Blueprint, request, jsonify
from app import db
from app.models.portals_texts import PortalsTexts
from app.models.portal import Portal
from app.utils.portal_permissions import check_portal_editor_permission

portal_bp = Blueprint('portal', __name__)

@portal_bp.route('/api/portal/text/delete', methods=['POST'])
def api_delete_portal_text():
    data = request.get_json()
    user_id = data.get('user_id')
    portals_texts_id = data.get('portals_texts_id')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not portals_texts_id:
        return jsonify({'error': 'portals_texts_id required!'}), 400

    text = PortalsTexts.query.filter_by(id=portals_texts_id).first()
    if not text:
        return jsonify({'error': "the portal text doesn't exist!"}), 404

    # Check permission
    if not check_portal_editor_permission(user_id, text.portals_id):
        return jsonify({'error': 'Permission denied'}), 403

    db.session.delete(text)
    db.session.commit()
    return jsonify({'result': 'ok'})
    