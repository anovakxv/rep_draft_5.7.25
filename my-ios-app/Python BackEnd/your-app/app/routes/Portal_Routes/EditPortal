from flask import Blueprint, request, jsonify, session
from app import db
from app.models.portal import Portal
from app.models.portals_users import PortalsUsers
from app.models.portals_texts import PortalsTexts
from app.utils.portal_permissions import check_portal_editor_permission
from datetime import datetime

portal_bp = Blueprint('portal', __name__)

@portal_bp.route('/api/portal/edit', methods=['POST'])
def api_edit_portal():
    data = request.get_json()
    user_id = session.get('user_id') or data.get('user_id')
    portal_id = data.get('portals_id')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not portal_id:
        return jsonify({'error': 'portals_id required!'}), 400

    if not check_portal_editor_permission(user_id, portal_id):
        return jsonify({'error': 'Permission denied'}), 403

    portal = Portal.query.filter_by(id=portal_id).first()
    if not portal:
        return jsonify({'error': 'Portal not found'}), 404

    # Update main portal fields
    update_fields = ['name', 'subtitle', 'categories_id', 'cities_id', 'about', 'lead_id', 'visible']
    for field in update_fields:
        if data.get(field) is not None:
            setattr(portal, field, data[field])
    portal.updated_at = datetime.utcnow()

    # Handle deleting graphic group hashes (implement your own logic)
    if isinstance(data.get('aDeleteGraphicGroupHashes'), list) and data['aDeleteGraphicGroupHashes']:
        # Example: delete S3Content or related files by group hash
        # from app.models.s3_content import S3Content
        # S3Content.query.filter(S3Content.gr_hash.in_(data['aDeleteGraphicGroupHashes'])).delete(synchronize_session=False)
        pass

    # Handle deleting graphic section IDs (implement your own logic)
    if isinstance(data.get('aDeletePGSIDs'), list) and data['aDeletePGSIDs']:
        # from app.models.portals_graphic_sections import PortalsGraphicSections
        # PortalsGraphicSections.query.filter(PortalsGraphicSections.id.in_(data['aDeletePGSIDs'])).delete(synchronize_session=False)
        pass

    # Handle sections update/add (implement your own logic)
    if isinstance(data.get('aSections'), list) and data['aSections']:
        # Implement add/update logic for graphic sections here
        pass

    # Handle texts
    if 'aTexts' in data:
        PortalsTexts.query.filter_by(portals_id=portal_id).delete(synchronize_session=False)
        texts = data['aTexts']
        for text_obj in texts:
            title = text_obj.get('title', '').strip()
            text = text_obj.get('text', '').strip()
            if title or text:
                new_text = PortalsTexts(portals_id=portal_id, title=title, text=text)
                db.session.add(new_text)

    # Handle leads/users
    if isinstance(data.get('aLeadsIDs'), list) and data['aLeadsIDs']:
        leads_ids = list(set([int(i) for i in data['aLeadsIDs'] if str(i).strip().isdigit()]))
        if leads_ids:
            # Remove old leads for this portal
            PortalsUsers.query.filter(
                PortalsUsers.portals_id == portal_id,
                PortalsUsers.users_id.in_(leads_ids)
            ).delete(synchronize_session=False)
            # Add new leads
            for lead_id in leads_ids:
                db.session.add(PortalsUsers(users_id=lead_id, portals_id=portal_id, leader=True))

    # Update users count
    users_count = PortalsUsers.query.filter_by(portals_id=portal_id).count()
    portal._c_users_count = users_count

    db.session.commit()

    return jsonify({'result': 'Portal updated', 'portal_id': portal_id})
