from flask import Blueprint, request, jsonify, session
from app.models.portal import Portal
from app.models.goals import Goal
from app.models.portals_users import PortalsUsers
from app.models.portals_texts import PortalsTexts
from app.models.user import User
from app.models.portals_graphic_sections import PortalsGraphicSections
from app.models.s3_content import S3Content
from sqlalchemy.orm import joinedload

portal_bp = Blueprint('portal', __name__)

@portal_bp.route('/api/portal/details', methods=['GET'])
def api_portal_details():
    portal_id = request.args.get('portals_id', type=int)
    user_id = session.get('user_id') or request.args.get('user_id', type=int)

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not portal_id:
        return jsonify({'error': 'portals_id required!'}), 400

    portal = Portal.query.options(
        joinedload(Portal.creator),
        joinedload(Portal.lead),
        joinedload(Portal.category),
        joinedload(Portal.city)
    ).filter_by(id=portal_id).first()
    if not portal:
        return jsonify({'error': "The portal doesn't exist"}), 404

    # Main portal info
    portal_data = {
        'id': portal.id,
        'name': portal.name,
        'subtitle': portal.subtitle,
        'about': portal.about,
        'categories_id': portal.categories_id,
        'cities_id': portal.cities_id,
        'lead_id': portal.lead_id,
        'users_id': portal.users_id,
        '_c_users_count': getattr(portal, '_c_users_count', None),
    }

    # Goals
    goals = Goal.query.filter_by(portals_id=portal.id).order_by(Goal.id.desc()).all()
    portal_data['aGoals'] = [g.as_dict() for g in goals] if goals else []

    # Portal users
    portal_users = PortalsUsers.query.filter_by(portals_id=portal.id).order_by(PortalsUsers.id.desc()).all()
    portal_data['aPortalUsers'] = [pu.as_dict() for pu in portal_users] if portal_users else []

    # Portal texts
    texts = PortalsTexts.query.filter_by(portals_id=portal.id).order_by(PortalsTexts.id.asc()).all()
    portal_data['aTexts'] = [t.as_dict() for t in texts] if texts else []

    # Sections (graphic sections) with S3 files
    sections = PortalsGraphicSections.query.filter_by(portals_id=portal.id).all()
    section_ids = [section.id for section in sections]
    files_by_section = {}
    if section_ids:
        files = S3Content.query.filter(S3Content.tbl_index == 6, S3Content.tbl_id.in_(section_ids)).all()
        for f in files:
            files_by_section.setdefault(f.tbl_id, []).append({
                'id': f.id,
                'gr_hash': f.gr_hash,
                'key': f.key,
                'url': f.url
            })
    aSections = []
    for section in sections:
        aSections.append({
            'id': section.id,
            'title': section.title,
            'aFiles': files_by_section.get(section.id, [])
        })
    portal_data['aSections'] = aSections

    # Users (owners and portal users)
    user_ids = set([portal.users_id] + [pu.users_id for pu in portal_users])
    users = User.query.filter(User.id.in_(user_ids)).all()
    portal_data['aUsers'] = [u.as_dict() for u in users] if users else []

    return jsonify({'result': portal_data})
