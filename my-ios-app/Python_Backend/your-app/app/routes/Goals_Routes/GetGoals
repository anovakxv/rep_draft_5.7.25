from app import db
from collections import defaultdict
from datetime import datetime

class Goal(db.Model):
    __tablename__ = 'goals'

    id = db.Column(db.Integer, primary_key=True)
    title = db.Column(db.String(255), nullable=False)
    subtitle = db.Column(db.String(255))
    users_id = db.Column(db.Integer, db.ForeignKey('users.id'), nullable=False, index=True)
    portals_id = db.Column(db.Integer, db.ForeignKey('portals.id'), nullable=False, index=True)
    lead_id = db.Column(db.Integer, db.ForeignKey('users.id'))
    description = db.Column(db.Text, nullable=False)
    quota = db.Column(db.Integer, default=100)
    filled_quota = db.Column(db.Integer, default=0)
    quota_is_reached_note = db.Column(db.Boolean, default=False)
    goal_types_id = db.Column(db.Integer, db.ForeignKey('goal_types.id'), nullable=False, index=True)
    goal_metrics_id = db.Column(db.Integer, db.ForeignKey('goal_metrics.id'), nullable=False, index=True)
    rep_commission = db.Column(db.Float)
    reporting_increments_id = db.Column(db.Integer, db.ForeignKey('reporting_increments.id'), nullable=False, index=True)

    # Relationships
    creator = db.relationship('User', foreign_keys=[users_id])
    lead = db.relationship('User', foreign_keys=[lead_id])
    portal = db.relationship('Portal', backref='goals')
    goal_type = db.relationship('GoalType', backref='goals')
    goal_metric = db.relationship('GoalMetric', backref='goals')
    reporting_increment = db.relationship('ReportingIncrement', backref='goals')
    progress_logs = db.relationship('GoalProgressLog', backref='goal', lazy='dynamic')
    team_members = db.relationship('GoalTeam', backref='goal', lazy='dynamic')
    pre_invites = db.relationship('GoalPreInvite', backref='goal', lazy='dynamic')

    def __repr__(self):
        return f"<Goal id={self.id} title={self.title} description={self.description[:20]}>"

    @property
    def progress(self):
        return round(self.filled_quota / self.quota, 2) if self.quota else 0

    def chart_data(self, increment='month', num_periods=4):
        logs = self.progress_logs.order_by(self.progress_logs.prop.mapper.class_.timestamp.asc()).all()
        data = defaultdict(int)
        for log in logs:
            if log.timestamp:
                if increment == 'month':
                    label = log.timestamp.strftime('%b')
                elif increment == 'week':
                    label = f"W{log.timestamp.isocalendar()[1]}"
                elif increment == 'day':
                    label = log.timestamp.strftime('%d %b')
                else:
                    label = log.timestamp.strftime('%b')
                data[label] += log.added_value or 0
        items = list(data.items())[-num_periods:]
        return [
            {"value": value, "label": label, "color": "#00FF00"}
            for label, value in items
        ]
    # shorter as_dict method for card mode
    def as_dict(self, card_mode=False, include_team=False, include_progress_logs=False):
        if card_mode:
            return {
                "id": self.id,
                "title": self.title,
                "subtitle": self.subtitle or "",
                "progressPercent": round(100 * self.filled_quota / self.quota) if self.quota else 0,
                "typeName": self.goal_type.title if self.goal_type else "",
                "chartData": [
                    {
                        "value": d["value"],
                        "valueLabel": str(d["value"]),
                        "bottomLabel": d["label"]
                    }
                    for d in self.chart_data()
                ],
                "portalsId": self.portals_id,
            }
        # Full detail mode (as before)
        chart_data = [
            {
                "value": d["value"],
                "valueLabel": str(d["value"]),
                "bottomLabel": d["label"]
            }
            for d in self.chart_data()
        ]
        quota_string = str(self.quota)
        value_string = str(self.filled_quota)
        team = None
        if include_team:
            team = [
                {
                    "id": tm.member.id,
                    "name": f"{tm.member.fname or ''} {tm.member.lname or ''}".strip(),
                    "imageName": "profile_placeholder"
                }
                for tm in self.team_members if tm.confirmed == 1 and tm.member
            ]
        a_latest_progress = None
        if include_progress_logs:
            logs = self.progress_logs.order_by(self.progress_logs.prop.mapper.class_.timestamp.desc()).limit(4).all()
            a_latest_progress = [
                {
                    "id": log.id,
                    "users_id": log.users_id,
                    "added_value": log.added_value,
                    "note": log.note,
                    "value": log.value,
                    "timestamp": log.timestamp.isoformat() if log.timestamp else None
                }
                for log in logs
            ]
        return {
            "id": self.id,
            "title": self.title,
            "subtitle": self.subtitle or "",
            "description": self.description or "",
            "progress": round(self.filled_quota / self.quota, 2) if self.quota else 0,
            "progressPercent": round(100 * self.filled_quota / self.quota) if self.quota else 0,
            "quota": self.quota,
            "filledQuota": self.filled_quota,
            "metricName": self.goal_metric.title if self.goal_metric else "",
            "typeName": self.goal_type.title if self.goal_type else "",
            "reportingName": self.reporting_increment.title if self.reporting_increment else "",
            "quotaString": quota_string,
            "valueString": value_string,
            "chartData": chart_data,
            "aLatestProgress": a_latest_progress,
            "team": team,
