// You may want to update ProfileCard to conform to Codable/Equatable as well:
struct ProfileCard: Identifiable, Codable, Equatable {
    let id: String = UUID().uuidString
    let title: String
    let description: String
    let imageUrl: String
    let isCustomBackground: Bool
    let backgroundColor: String? // Store as hex string if needed
    // customContent is not Codable; omit or handle separately

    init(
        title: String,
        description: String,
        imageUrl: String,
        isCustomBackground: Bool = false,
        backgroundColor: String? = nil,
        customContent: Any? = nil // Not Codable, for UI only
    ) {
        self.title = title
        self.description = description
        self.imageUrl = imageUrl
        self.isCustomBackground = isCustomBackground
        self.backgroundColor = backgroundColor
    }
    