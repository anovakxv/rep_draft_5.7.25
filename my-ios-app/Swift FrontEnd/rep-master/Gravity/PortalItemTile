import SwiftUI

struct PortalItem: View {
    var portal: PortalModel

    var body: some View {
        HStack(alignment: .top, spacing: 12) {
            // Use AsyncImage if loading from URL, fallback to Image if local
            if let url = portal.imageURL {
                AsyncImage(url: url) { phase in
                    if let image = phase.image {
                        image
                            .resizable()
                            .aspectRatio(16/9, contentMode: .fill)
                    } else if phase.error != nil {
                        Color.gray
                    } else {
                        Color.gray.opacity(0.2)
                    }
                }
                .frame(width: 80, height: 45)
                .clipped()
                .cornerRadius(6)
                .accessibilityHidden(true)
            } else {
                Image(portal.imageName)
                    .resizable()
                    .aspectRatio(16/9, contentMode: .fill)
                    .frame(width: 80, height: 45)
                    .clipped()
                    .cornerRadius(6)
                    .accessibilityHidden(true)
            }

            VStack(alignment: .leading, spacing: 4) {
                HStack {
                    Text(portal.name)
                        .font(.subheadline)
                        .fontWeight(.medium)
                        .accessibilityLabel("Portal name: \(portal.name)")
                    Spacer()
                    Text(portal.category)
                        .font(.caption)
                        .foregroundColor(.secondary)
                        .accessibilityLabel("Category: \(portal.category)")
                }

                if !portal.subtitle.isEmpty {
                    Text(portal.subtitle)
                        .font(.caption)
                        .foregroundColor(.secondary)
                        .lineLimit(1)
                        .accessibilityLabel("Subtitle: \(portal.subtitle)")
                }

                HStack {
                    Text(portal.city)
                        .font(.caption)
                        .foregroundColor(.secondary)
                        .accessibilityLabel("City: \(portal.city)")
                    Spacer()
                    Text("\(portal.leads.count) leads")
                        .font(.caption)
                        .foregroundColor(.green)
                        .accessibilityLabel("\(portal.leads.count) leads")
                }
            }
        }
        .frame(height: 64)
        .padding(.horizontal)
        .padding(.vertical, 8)
        .background(Color.white)
        .cornerRadius(8)
        .shadow(color: Color.black.opacity(0.03), radius: 2, x: 0, y: 1)
    }
}

