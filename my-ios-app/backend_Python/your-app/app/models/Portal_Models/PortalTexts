from app import db
from datetime import datetime

class PortalText(db.Model):
    __tablename__ = 'portals_texts'

    id = db.Column(db.Integer, primary_key=True)
    portals_id = db.Column(db.Integer, db.ForeignKey('portals.id'), nullable=False, index=True)
    title = db.Column(db.String(255), nullable=False)  # Set to False if title is required, True if optional
    text = db.Column(db.Text, nullable=True)
    position = db.Column(db.Integer, nullable=True)  # Optional: for ordering
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    updated_at = db.Column(db.DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)

    portal = db.relationship('Portal', backref='portal_texts')

    def __repr__(self):
        return f"<PortalText id={self.id} portal_id={self.portals_id} title={self.title}>"
    