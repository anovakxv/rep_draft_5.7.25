
from app import db

class PortalUser(db.Model):
    __tablename__ = 'portals_users'

    id = db.Column(db.Integer, primary_key=True)
    users_id = db.Column(db.Integer, db.ForeignKey('users.id'), nullable=False)
    portals_id = db.Column(db.Integer, db.ForeignKey('portals.id'), nullable=False)
    leader = db.Column(db.Boolean, default=False)

    user = db.relationship('User', backref='portal_users')
    portal = db.relationship('Portal', backref='portal_users')

    def __repr__(self):
        return f"<PortalUser user_id={self.users_id} portal_id={self.portals_id} leader={self.leader}>"