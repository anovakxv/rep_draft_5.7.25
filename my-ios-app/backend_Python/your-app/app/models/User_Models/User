
from app import db

class User(db.Model):
    __tablename__ = 'users'

    id = db.Column(db.Integer, primary_key=True)
    email = db.Column(db.String(255), unique=True, nullable=False)
    about = db.Column(db.Text)
    broadcast = db.Column(db.Text)
    phone = db.Column(db.String(50))
    cities_id = db.Column(db.Integer, db.ForeignKey('cities.id'))
    users_types_id = db.Column(db.Integer, db.ForeignKey('user_types.id'))
    password = db.Column(db.String(255), nullable=False)
    fname = db.Column(db.String(100))
    lname = db.Column(db.String(100))
    username = db.Column(db.String(100), unique=True, nullable=False)
    confirmed = db.Column(db.Boolean, default=True)
    device_token = db.Column(db.String(255))
    twitter_id = db.Column(db.String(100))
    manual_city = db.Column(db.String(100))
    other_skill = db.Column(db.String(255))
    lat = db.Column(db.Float)
    lng = db.Column(db.Float)
    last_login = db.Column(db.DateTime)


    # Relationships (optional, for easier ORM queries)
    city = db.relationship('City', backref='users')
    user_type = db.relationship('UserType', backref='users')

    def __repr__(self):
        return f"<User id={self.id} username={self.username}>"
    