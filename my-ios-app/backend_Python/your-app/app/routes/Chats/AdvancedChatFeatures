
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.message import Message
from app.models.user import User
from app.models.messages_read import MessagesRead

user_bp = Blueprint('user', __name__)

@user_bp.route('/api/user/get_direct_messages_advanced', methods=['GET'])
def api_get_direct_messages_advanced():
    user_id = session.get('user_id')
    other_user_id = request.args.get('other_user_id')
    offset = int(request.args.get('offset', 0))
    limit = int(request.args.get('limit', 50))
    keyword = request.args.get('keyword', '')
    mark_as_read = request.args.get('mark_as_read', '0') == '1'

    if not user_id:
        return jsonify({'error': 'login required!'}), 401
    if not other_user_id:
        return jsonify({'error': 'other_user_id is required!'}), 400
    if offset < 0:
        return jsonify({'error': 'offset is wrong!'}), 400
    if limit > 4096:
        return jsonify({'error': 'limit should be <= 4096'}), 400

    # Check if the other user exists
    if not User.query.filter_by(id=other_user_id).first():
        return jsonify({'error': 'other user not found'}), 404

    # Filtering and pagination
    query = Message.query.filter(
        ((Message.users_id1 == user_id) & (Message.users_id2 == other_user_id)) |
        ((Message.users_id1 == other_user_id) & (Message.users_id2 == user_id))
    )
    if keyword:
        query = query.filter(Message.text.ilike(f"%{keyword}%"))

    messages = query.order_by(Message.timestamp.asc()).offset(offset).limit(limit).all()
    result = [m.as_dict() for m in messages]

    # Mark as read logic
    if mark_as_read:
        unread_ids = [
            m.id for m in messages
            if m.users_id2 == user_id and not MessagesRead.query.filter_by(users_id=user_id, messages_id=m.id).first()
        ]
        for mid in unread_ids:
            db.session.add(MessagesRead(users_id=user_id, messages_id=mid))
        db.session.commit()

