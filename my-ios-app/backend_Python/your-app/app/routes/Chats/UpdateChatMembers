
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.chats import Chats
from app.models.chats_users import ChatsUsers
from app.models.user import User

user_bp = Blueprint('user', __name__)

@user_bp.route('/api/user/update_chat_members', methods=['POST'])
def api_update_chat_members():
    data = request.get_json()
    user_id = session.get('user_id')
    chats_id = data.get('chats_id')
    add_ids = data.get('add_ids', [])
    remove_ids = data.get('remove_ids', [])

    if not user_id:
        return jsonify({'error': 'login required!'}), 401
    if not chats_id:
        return jsonify({'error': 'chats_id is required!'}), 400

    chat = Chats.query.filter_by(id=chats_id).first()
    if not chat:
        return jsonify({'error': 'chat not found'}), 404

    # Check if user is a member of the chat
    is_member = ChatsUsers.query.filter_by(chats_id=chats_id, users_id=user_id).count()
    if not is_member:
        return jsonify({'error': 'permission denied'}), 403

    # Add users
    added = []
    for uid in set(add_ids):
        if not User.query.filter_by(id=uid).first():
            continue
        exists = ChatsUsers.query.filter_by(chats_id=chats_id, users_id=uid).first()
        if not exists:
            db.session.add(ChatsUsers(users_id=uid, chats_id=chats_id))
            added.append(uid)

    # Remove users
    removed = []
    for uid in set(remove_ids):
        cu = ChatsUsers.query.filter_by(chats_id=chats_id, users_id=uid).first()
        if cu:
            db.session.delete(cu)
            removed.append(uid)

    db.session.commit()

    return jsonify
    