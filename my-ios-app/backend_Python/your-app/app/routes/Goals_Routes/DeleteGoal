
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.Goals_Models.Goal import Goal

goals_bp = Blueprint('goals', __name__)

@goals_bp.route('/api/goals/delete', methods=['POST'])
def api_delete_goal():
    data = request.json
    user_id = session.get('user_id')
    goal_id = data.get('goals_id')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not goal_id:
        return jsonify({'error': 'goals_id required!'}), 400

    goal = Goal.query.get(goal_id)
    if not goal:
        return jsonify({'error': "Goal not found"}), 404

    # Only the lead or owner can delete
    if goal.lead_id:
        if goal.lead_id != user_id:
            return jsonify({'error': "Only the Lead of the Goal can delete."}), 403
    else:
        if goal.users_id != user_id:
            return jsonify({'error': "Only the owner can delete this goal."}), 403

    # Optionally: delete related GoalTeam, GoalProgressLog, etc.
    # Example:
    # GoalTeam.query.filter_by(goals_id=goal.id).delete()
    # GoalProgressLog.query.filter_by(goals_id=goal.id).delete()
    # db.session.commit()

    db.session.delete(goal)
    db.session.commit()
    return jsonify({'result': 'ok'})
    