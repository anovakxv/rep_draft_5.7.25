
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.Goals_Models.Goal import Goal
from app.models.Goals_Models.User import User
from app.models.Goals_Models.GoalPreInvite import GoalPreInvite  # You need to define this model

goals_bp = Blueprint('goals', __name__)

@goals_bp.route('/api/goals/invite_email_friends', methods=['POST'])
def api_invite_email_friends_to_goal():
    data = request.json
    user_id = session.get('user_id')
    goal_id = data.get('goals_id')
    aEmails = data.get('aEmails', [])
    todo = data.get('todo', 'add')

    if not user_id:
        return jsonify({'error': 'login required!'}), 401
    if not goal_id:
        return jsonify({'error': 'goals_id is empty!'}), 400
    if not aEmails or not isinstance(aEmails, list):
        return jsonify({'error': 'aEmails is empty or wrong!'}), 400
    if todo not in ['add', 'delete']:
        return jsonify({'error': 'todo is empty or wrong! Supported: add, delete'}), 400

    goal = Goal.query.get(goal_id)
    if not goal:
        return jsonify({'error': 'goal: 404'}), 404

    log = {}

    for email in aEmails:
        email = email.strip()
        if not email:
            continue
        user = User.query.filter_by(email=email).first()
        if user:
            log[email] = f'already registered: {user.id}'
            # Optionally: add to team directly here
        else:
            if todo == 'add':
                # Check for existing pre-invite
                existing = GoalPreInvite.query.filter_by(
                    users_id=user_id, goals_id=goal_id, type='email', identifier=email
                ).first()
                if not existing:
                    preinvite = GoalPreInvite(
                        users_id=user_id,
                        goals_id=goal_id,
                        type='email',
                        identifier=email
                    )
                    db.session.add(preinvite)
                    log[email] = 'invited'
                    # Optionally: send email invite here
                else:
                    log[email] = 'already invited'
            elif todo == 'delete':
                deleted = GoalPreInvite.query.filter_by(
                    users_id=user_id, goals_id=goal_id, type='email', identifier=email
                ).delete()
                log[email] = 'deleted' if deleted else 'not found'

    db.session.commit()
    return jsonify({'result': log})
    