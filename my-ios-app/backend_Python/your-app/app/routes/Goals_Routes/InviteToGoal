
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.Goals_Models.Goal import Goal
from app.models.Goals_Models.User import User
from app.models.Goals_Models.GoalPreInvite import GoalPreInvite  # You need to define this model

goals_bp = Blueprint('goals', __name__)

@goals_bp.route('/api/goals/invite', methods=['POST'])
def api_invite_to_goal():
    data = request.json
    user_id = session.get('user_id')
    goal_id = data.get('goals_id')
    aEmails = data.get('aEmails', [])
    aFBIDs = data.get('aFBIDs', [])
    aPhones = data.get('aPhones', [])
    todo = data.get('todo', 'add')
    do_not_send_sms = data.get('do_not_send_sms', False)

    if not user_id:
        return jsonify({'error': 'login required!'}), 401
    if not goal_id:
        return jsonify({'error': 'goals_id is empty!'}), 400
    if todo not in ['add', 'delete']:
        return jsonify({'error': 'todo is empty or wrong! Supported: add, delete'}), 400

    goal = Goal.query.get(goal_id)
    if not goal:
        return jsonify({'error': 'goal: 404'}), 404

    log = {}

    # --- Handle Email Invites ---
    if aEmails:
        for email in aEmails:
            email = email.strip()
            if not email:
                continue
            user = User.query.filter_by(email=email).first()
            if user:
                log[email] = f'already registered: {user.id}'
                # Optionally: add to team directly
            else:
                if todo == 'add':
                    preinvite = GoalPreInvite(
                        users_id=user_id,
                        goals_id=goal_id,
                        type='email',
                        identifier=email
                    )
                    db.session.add(preinvite)
                    log[email] = 'invited'
                    # Optionally: send email here
                elif todo == 'delete':
                    GoalPreInvite.query.filter_by(
                        users_id=user_id, goals_id=goal_id, type='email', identifier=email
                    ).delete()
                    log[email] = 'deleted'

    # --- Handle Phone Invites ---
    if aPhones:
        for phone in aPhones:
            phone = phone.strip()
            if not phone:
                continue
            user = User.query.filter_by(phone=phone).first()
            if user:
                log[phone] = f'already registered: {user.id}'
                # Optionally: add to team directly
            else:
                if todo == 'add':
                    preinvite = GoalPreInvite(
                        users_id=user_id,
                        goals_id=goal_id,
                        type='phone',
                        identifier=phone
                    )
                    db.session.add(preinvite)
                    log[phone] = 'invited'
                    # Optionally: send SMS here (skip if do_not_send_sms)
                elif todo == 'delete':
                    GoalPreInvite.query.filter_by(
                        users_id=user_id, goals_id=goal_id, type='phone', identifier=phone
                    ).delete()
                    log[phone] = 'deleted'

    # --- Handle Facebook Invites ---
    if aFBIDs:
        for fb_id in aFBIDs:
            fb_id = str(fb_id).strip()
            if not fb_id:
                continue
            user = User.query.filter_by(facebook_id=fb_id).first()
            if user:
                log[fb_id] = f'already registered: {user.id}'
                # Optionally: add to team directly
            else:
                if todo == 'add':
                    preinvite = GoalPreInvite(
                        users_id=user_id,
                        goals_id=goal_id,
                        type='fb',
                        identifier=fb_id
                    )
                    db.session.add(preinvite)
                    log[fb_id] = 'invited'
                    # Optionally: send FB invite here
                elif todo == 'delete':
                    GoalPreInvite.query.filter_by(
                        users_id=user_id, goals_id=goal_id, type='fb', identifier=fb_id
                    ).delete()
                    log[fb_id] = 'deleted'

    db.session.commit()
    return jsonify({'result': log})
    