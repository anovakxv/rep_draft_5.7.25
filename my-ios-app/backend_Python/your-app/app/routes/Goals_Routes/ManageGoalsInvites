
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.Goals_Models.GoalTeam import GoalTeam
from app.models.Goals_Models.Goal import Goal

goals_bp = Blueprint('goals', __name__)

@goals_bp.route('/api/goals/manage_invites', methods=['POST'])
def api_manage_goals_invites():
    data = request.json
    user_id = session.get('user_id')
    goals_ids = data.get('aGoalsIDs', [])
    todo = data.get('todo')  # 'accept', 'decline', 'delete', 'mark_as_read'

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not goals_ids or todo not in ['accept', 'decline', 'delete', 'mark_as_read']:
        return jsonify({'error': 'Invalid request'}), 400

    results = {}

    if todo == 'mark_as_read':
        c1 = GoalTeam.query.filter(
            GoalTeam.users_id1 == user_id,
            GoalTeam.goals_id.in_(goals_ids)
        ).update({'read1': True}, synchronize_session=False)
        c2 = GoalTeam.query.filter(
            GoalTeam.users_id2 == user_id,
            GoalTeam.goals_id.in_(goals_ids)
        ).update({'read2': True}, synchronize_session=False)
        db.session.commit()
        total = c1 + c2
        return jsonify({'result': total if total else "0 marked"})

    if todo == 'delete':
        deleted = GoalTeam.query.filter(
            ((GoalTeam.users_id1 == user_id) | (GoalTeam.users_id2 == user_id)) &
            (GoalTeam.goals_id.in_(goals_ids))
        ).delete(synchronize_session=False)
        db.session.commit()
        return jsonify({'result': deleted if deleted else "0 deleted"})

    if todo == 'decline':
        updated = GoalTeam.query.filter(
            GoalTeam.users_id2 == user_id,
            GoalTeam.goals_id.in_(goals_ids)
        ).update({'confirmed': -1, 'read2': True}, synchronize_session=False)
        db.session.commit()
        return jsonify({'result': updated if updated else "0 declined"})

    if todo == 'accept':
        # Accept invites and log progress if needed
        invites = GoalTeam.query.filter(
            GoalTeam.users_id2 == user_id,
            GoalTeam.goals_id.in_(goals_ids)
        ).all()
        aLog = {}
        for invite in invites:
            if invite.confirmed != 1:
                invite.confirmed = 1
                invite.read2 = True
                # Optionally: log progress, send notification, etc.
                aLog[invite.goals_id] = 'ok'
            else:
                aLog[invite.goals_id] = 'already a member'
        db.session.commit()
        return jsonify({'result': aLog})

    return jsonify({'error': 'something wrong'}), 400
    