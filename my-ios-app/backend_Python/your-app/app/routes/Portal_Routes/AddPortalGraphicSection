
from flask import Blueprint, request, jsonify
from app import db
from app.models.portals_graphic_sections import PortalsGraphicSections
from app.models.portals_graphic_sections_s3_content import PortalsGraphicSectionsS3Content
from app.models.s3_content import S3Content
from app.utils.portal_permissions import check_portal_editor_permission

portal_bp = Blueprint('portal', __name__)

@portal_bp.route('/api/portal/graphic_sections/add', methods=['POST'])
def api_add_portal_graphic_sections():
    data = request.get_json()
    user_id = data.get('user_id')
    portal_id = data.get('portals_id')
    sections = data.get('aSections')
    return_result = data.get('__return_result', '')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not portal_id:
        return jsonify({'error': 'portals_id required!'}), 400
    if not isinstance(sections, list) or not sections:
        return jsonify({'error': 'aSections is empty or wrong!'}), 400

    if not check_portal_editor_permission(user_id, portal_id):
        return jsonify({'error': 'Permission denied'}), 403

    aLog = []
    aInsertSQL = []

    for idx, section in enumerate(sections):
        section_id = section.get('id')
        title = section.get('title', '')
        indexes = section.get('indexes', '')

        # Find or create section
        if section_id:
            pgs = PortalsGraphicSections.query.filter_by(id=section_id, portals_id=portal_id).first()
            if not pgs:
                aLog.append({'error': f'portals_graphic_sections_id: 404 or 503', 'index': idx})
                continue
            if title:
                pgs.title = title
        else:
            pgs = PortalsGraphicSections(portals_id=portal_id, title=title)
            db.session.add(pgs)
            db.session.flush()  # Get id before commit

        if not indexes:
            aLog.append({'error': 'indexes is empty', 'index': idx})
            continue

        file_indexes = [i.strip() for i in indexes.split(',') if i.strip()]
        if not file_indexes:
            aLog.append({'error': 'comma separated string is wrong', 'index': idx})
            continue

        # Here you would link S3 files to this section.
        # For demo, we assume gr_hashes are provided in file_indexes.
        files_log = []
        for gr_hash in file_indexes:
            # Optionally, validate gr_hash exists in s3_content
            s3_file = S3Content.query.filter_by(gr_hash=gr_hash, tbl_index=6).first()
            if s3_file:
                link = PortalsGraphicSectionsS3Content(
                    portals_graphic_sections_id=pgs.id,
                    s3_gr_hash=gr_hash
                )
                db.session.add(link)
                files_log.append({'gr_hash': gr_hash})
            else:
                files_log.append({'gr_hash': gr_hash, 'error': 'S3 file not found'})

        aLog.append({
            'portals_graphic_sections_id': pgs.id,
            'aFiles': files_log
        })

    db.session.commit()

    if return_result == "1":
        return jsonify({'result': aLog})
    return jsonify({'result': aLog})