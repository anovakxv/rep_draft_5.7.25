
from flask import Blueprint, request, jsonify
from app import db
from app.models.portals_graphic_sections import PortalsGraphicSections
from app.models.s3_content import S3Content
from app.models.portals_graphic_sections_s3_content import PortalsGraphicSectionsS3Content
from app.utils.portal_permissions import check_portal_editor_permission

portal_bp = Blueprint('portal', __name__)

@portal_bp.route('/api/portal/graphic_sections/delete', methods=['POST'])
def api_delete_portal_graphic_sections():
    data = request.get_json()
    user_id = data.get('user_id')
    pgs_ids = data.get('aPGSIDs')
    return_result = data.get('__return_result', '')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not isinstance(pgs_ids, list) or not pgs_ids:
        return jsonify({'error': 'aPGSIDs is empty or wrong'}), 400

    # Check existence and permissions
    sections = PortalsGraphicSections.query.filter(PortalsGraphicSections.id.in_(pgs_ids)).all()
    if len(sections) != len(pgs_ids):
        return jsonify({'error': 'Some aPGSIDs are invalid'}), 400

    for section in sections:
        if not check_portal_editor_permission(user_id, section.portals_id):
            return jsonify({'error': 'Permission denied'}), 403

    # Get all related s3_content gr_hashes
    gr_hashes = db.session.query(S3Content.gr_hash).filter(
        S3Content.tbl_index == 6,
        S3Content.tbl_id.in_(pgs_ids)
    ).distinct().all()
    gr_hashes = [gh[0] for gh in gr_hashes]

    # Delete from portals_graphic_sections_s3_content
    PortalsGraphicSectionsS3Content.query.filter(
        PortalsGraphicSectionsS3Content.portals_graphic_sections_id.in_(pgs_ids)
    ).delete(synchronize_session=False)

    # Delete portals_graphic_sections
    PortalsGraphicSections.query.filter(
        PortalsGraphicSections.id.in_(pgs_ids)
    ).delete(synchronize_session=False)

    # Delete s3_content records and files
    if gr_hashes:
        s3_files = S3Content.query.filter(S3Content.gr_hash.in_(gr_hashes)).all()
        for s3_file in s3_files:
            db.session.delete(s3_file)
            # If you have a method to delete the actual file from S3, call it here

    db.session.commit()

    if return_result == '1':
        return jsonify({'result': gr_hashes})
    return jsonify({'result': gr_hashes})
    