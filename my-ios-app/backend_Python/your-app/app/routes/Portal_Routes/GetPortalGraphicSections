
from flask import Blueprint, request, jsonify
from app.models.portals_graphic_sections import PortalsGraphicSections
from app.models.s3_content import S3Content

portal_bp = Blueprint('portal', __name__)

@portal_bp.route('/api/portal/graphic_sections', methods=['GET'])
def api_get_portal_graphic_sections():
    portal_id = request.args.get('portals_id')
    user_id = request.args.get('user_id')
    return_result = request.args.get('__return_result', '')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not portal_id:
        return jsonify({'error': 'portals_id required!'}), 400

    sections = PortalsGraphicSections.query.filter_by(portals_id=portal_id).all()
    result = []
    for section in sections:
        # Get S3 files for this section (tbl_index=6)
        files = S3Content.query.filter_by(tbl_index=6, tbl_id=section.id).all()
        files_data = [
            {
                'id': f.id,
                'gr_hash': f.gr_hash,
                'key': f.key,
                'url': f.url
            }
            for f in files
        ]
        result.append({
            'id': section.id,
            'title': section.title,
            'aFiles': files_data
        })

    if return_result == "1":
        return jsonify({'result': result})
    return jsonify({'result': result})
    