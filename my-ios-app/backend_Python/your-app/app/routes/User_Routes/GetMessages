
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.message import Message
from app.models.user import User
from app.models.portal import Portal
from app.models.chats import Chats
from app.models.messages_read import MessagesRead
from app.models.chats_users import ChatsUsers
from app.models.users_hidden_conversations import UsersHiddenConversations
from app.models.chats_hidden_conversations import ChatsHiddenConversations

user_bp = Blueprint('user', __name__)

@user_bp.route('/api/user/get_messages', methods=['GET'])
def api_get_messages():
    user_id = session.get('user_id')
    if not user_id:
        return jsonify({'error': 'Login error!'}), 401

    args = request.args
    keyword = args.get('keyword', '')
    keyword_text = args.get('keyword_text', '')
    keyword_flname = args.get('keyword_flname', '')
    show_hidden = args.get('show_hidden', '1')
    newer_than_id = args.get('newer_than_id')
    chats_id = args.get('chats_id')
    users_id = args.get('users_id')
    order = args.get('order', 'ASC').upper()
    limit = int(args.get('limit', 50))
    offset = int(args.get('offset', 0))

    if order not in ['ASC', 'DESC']:
        return jsonify({'error': 'order is wrong! ASC or DESC required'}), 400
    if offset < 0:
        return jsonify({'error': 'offset is wrong!'}), 400
    if limit > 4096:
        return jsonify({'error': 'limit should be < 4096'}), 400

    # Mark already read messages
    already_read_ids = set(
        r.messages_id for r in MessagesRead.query.filter_by(users_id=user_id).limit(1024).all()
    )

    # Build base query
    query = Message.query

    # Filtering by newer_than_id
    if newer_than_id:
        query = query.filter(Message.id > int(newer_than_id))

    # Filtering by keyword
    if keyword:
        keyword_text = keyword_flname = keyword
    if keyword_text and not keyword_flname:
        query = query.filter(Message.text.ilike(f"%{keyword_text}%"))

    # Filtering by portal
    if args.get('portals_id'):
        query = query.filter(Message.portals_id == args.get('portals_id'))

    # Filtering by chat or user
    if not users_id and not chats_id:
        # Inbox/grouped view
        # Exclude hidden conversations if needed
        if show_hidden != "1":
            hidden_ids = db.session.query(UsersHiddenConversations.users_id2).filter_by(users_id1=user_id)
            query = query.filter(~Message.users_id1.in_(hidden_ids), ~Message.users_id2.in_(hidden_ids))
            hidden_chats = db.session.query(ChatsHiddenConversations.chats_id).filter_by(users_id=user_id)
            query = query.filter(~Message.chats_id.in_(hidden_chats))
        # Only messages where user is a participant
        query = query.filter(
            (Message.users_id1 == user_id) | (Message.users_id2 == user_id) |
            (Message.chats_id.in_(
                db.session.query(ChatsUsers.chats_id).filter_by(users_id=user_id)
            ))
        )
        # Optionally filter by name
        if keyword_flname:
            user_ids = [
                u.id for u in User.query.filter(
                    (User.fname + ' ' + User.lname).ilike(f"%{keyword_flname.lower()}%")
                )
            ]
            query = query.filter(
                (Message.users_id1.in_(user_ids)) | (Message.users_id2.in_(user_ids))
            )
        # Grouping and aggregation would be handled in Python after fetching
        messages = query.order_by(Message.timestamp.desc()).offset(offset).limit(limit).all()
    elif chats_id:
        query = query.filter(Message.chats_id == chats_id)
        messages = query.order_by(Message.timestamp.asc() if order == 'ASC' else Message.timestamp.desc()).offset(offset).limit(limit).all()
    else:
        # Direct conversation
        query = query.filter(
            ((Message.users_id1 == user_id) & (Message.users_id2 == users_id)) |
            ((Message.users_id2 == user_id) & (Message.users_id1 == users_id))
        )
        messages = query.order_by(Message.timestamp.asc() if order == 'ASC' else Message.timestamp.desc()).offset(offset).limit(limit).all()

    # Collect user IDs, portal IDs, chat IDs for enrichment
    user_ids = set()
    portal_ids = set()
    chat_ids = set()
    aData = []
    new_messages_count = 0

    for msg in messages:
        msg_dict = msg.as_dict()
        if msg.portals_id:
            portal_ids.add(msg.portals_id)
        if msg.chats_id:
            chat_ids.add(msg.chats_id)
        user_ids.add(msg.users_id1)
        user_ids.add(msg.users_id2)
        # Mark read status
        if msg.chats_id:
            msg_dict['read'] = '1' if msg.id in already_read_ids else '0'
        elif msg.users_id2 != user_id and not msg.chats_id:
            msg_dict['read'] = '1'
        else:
            msg_dict['read'] = '0'
        aData.append(msg_dict)

    # Mark messages as read if needed
    if aData and users_id:
        msg_ids = [m['id'] for m in aData]
        Message.query.filter(Message.id.in_(msg_ids), Message.users_id2 == user_id).update({'read': 1})
        db.session.commit()
    if aData and chats_id:
        unread_ids = [m['id'] for m in aData if m['read'] == '0']
        for mid in unread_ids:
            db.session.add(MessagesRead(users_id=user_id, chats_id=chats_id, messages_id=mid))
        db.session.commit()

    # Enrich with users, portals, chats
    users = User.query.filter(User.id.in_(user_ids)).all()
    portals = Portal.query.filter(Portal.id.in_(portal_ids)).all() if portal_ids else []
    chats = Chats.query.filter(Chats.id.in_(chat_ids)).all() if chat_ids else []

    aUsers = [u.as_dict() for u in users]
    aPortals = [p.as_dict() for p in portals]
    aChats = [c.as_dict() for c in chats]

    result = {
        'aData': aData,
        'aUsers': aUsers,
        'aPortals': aPortals,
        'aChats': aChats
    }
    