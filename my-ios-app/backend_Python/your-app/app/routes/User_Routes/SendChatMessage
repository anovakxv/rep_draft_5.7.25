
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.message import Message
from app.models.portal import Portal

user_bp = Blueprint('user', __name__)

@user_bp.route('/api/user/send_chat_message', methods=['POST'])
def api_send_chat_message():
    data = request.get_json()
    user_id = session.get('user_id')
    chats_id = data.get('chats_id')
    message_text = data.get('message')
    portals_id = data.get('portals_id', None)
    return_result = data.get('__return_result', '')

    if not user_id:
        return jsonify({'error': 'Login error!'}), 401
    if not chats_id:
        return jsonify({'error': 'chats_id is empty!'}), 400
    if not message_text:
        return jsonify({'error': 'message required!'}), 400

    # Optional: Check if portal exists
    if portals_id:
        portal = Portal.query.filter_by(id=portals_id).first()
        if not portal:
            return jsonify({'error': "the portal doesn't exist!"}), 404

    # Create message
    msg = Message(
        users_id1=user_id,
        chats_id=chats_id,
        portals_id=portals_id,
        text=message_text
    )
    db.session.add(msg)
    db.session.commit()

    # Optionally, remove hidden chat conversations
    db.session.execute(
        "DELETE FROM chats_hidden_conversations WHERE chats_id=:cid",
        {'cid': chats_id}
    )
    db.session.commit()

    if return_result == "1":
        return jsonify({'result': 'sent'})
    return
    