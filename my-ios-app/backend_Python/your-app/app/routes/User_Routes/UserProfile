
from flask import Blueprint, request, jsonify, session
from app import db
from app.models.user import User
from app.models.users_followers import UsersFollowers
from app.models.users_network import UsersNetwork
from app.utils.user_utils import manage_user_row

user_bp = Blueprint('user', __name__)

@user_bp.route('/api/user/profile', methods=['GET'])
def api_user_profile():
    users_id = request.args.get('users_id')
    session_user_id = session.get('user_id')

    if not users_id and not session_user_id:
        return jsonify({'error': 'login or users_id required!'}), 401

    if not users_id:
        users_id = session_user_id

    user = User.query.filter_by(id=users_id).first()
    if not user:
        return jsonify({'error': "That user doesn't exist!"}), 404

    row = user.as_dict()

    if session_user_id:
        row['i_follow'] = UsersFollowers.query.filter_by(users_id1=session_user_id, users_id2=users_id).count()
        row['i_am_followed_by'] = UsersFollowers.query.filter_by(users_id2=session_user_id, users_id1=users_id).count()
        row['in_my_network'] = UsersNetwork.query.filter_by(users_id1=session_user_id, users_id2=users_id).count()
        row['i_am_in_their_network'] = UsersNetwork.query.filter_by(users_id2=session_user_id, users_id1=users_id).count()
    else:
        row['i_follow'] = '-'
        row['i_am_followed_by'] = '-'
        row['in_my_network'] = '-'
        row['i_am_in_their_network'] = '-'

    level = '0' if str(session_user_id) == str(users_id) else '1'
